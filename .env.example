# Drop — environment. Copy to .env and adjust. Loaded from the repo root by @drop/core.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://drop:drop@localhost:5440/drop

# --- Storage --------------------------------------------------------------
# s3 | fs   (fs is for local dev/tests only)
STORAGE_DRIVER=s3
STORAGE_FS_ROOT=.data/storage
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=drop-sites
S3_ACCESS_KEY=drop
S3_SECRET_KEY=dropdropdrop
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- URLs (origins must differ: uploaded sites run untrusted JS) ----------
CONTROL_URL=http://localhost:3100
SITES_URL=http://localhost:3101

# --- Auth -----------------------------------------------------------------
# Signs the drop_session cookie. Must be >= 32 chars when NODE_ENV=production.
SESSION_SECRET=change-me-32-bytes-minimum
# mock | oidc
AUTH_PROVIDER=mock
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated emails that get admin endpoints.
ADMIN_EMAILS=admin@example.com

# --- Expiry and tokens ----------------------------------------------------
DEFAULT_EXPIRY_DAYS=30
# Delete storage this long after expiry; the row and path ownership stay.
EXPIRED_RETENTION_DAYS=30
CLI_TOKEN_TTL_DAYS=90

# --- Upload limits --------------------------------------------------------
MAX_FILES=5000
MAX_FILE_BYTES=26214400
MAX_SITE_BYTES=209715200
MAX_ARCHIVE_BYTES=209715200
